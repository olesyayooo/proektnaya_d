// Общий модуль ОбменБиблиотека: Сервер = Да, Клиент = Нет,
// Вызов сервера = Нет, Глобальный = Нет, Привилегированный = Нет.

Функция ПроверитьHTTP() Экспорт
    // Без записи в PostgreSQL: проверка встроенных HTTP-операций именно в этой 1С.
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Новый Структура("test", "Проверка UTF-8"));
    ТестJSON = Запись.Закрыть();
    Соединение = Новый HTTPСоединение("127.0.0.1", 8000, , , , 10);
    Запрос = Новый HTTPЗапрос("/integration/purchases");
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Запрос.УстановитьТелоИзСтроки(ТестJSON, КодировкаТекста.UTF8,
        ИспользованиеByteOrderMark.НеИспользовать);
    // Ключ намеренно не передается. 401 подтверждает HTTP POST без импорта.
    Ответ = Соединение.ОтправитьДляОбработки(Запрос);
    Если Ответ.КодСостояния = 401 Тогда
        Возврат "HTTP POST и JSON доступны. FastAPI ответил 401 на запрос без ключа (ожидаемо).";
    КонецЕсли;
    Если Ответ.КодСостояния = 503 Тогда
        Возврат "HTTP POST и JSON доступны. FastAPI ответил 503: настройте ключ и перезапустите backend.";
    КонецЕсли;
    ВызватьИсключение "Проверка не завершена: ожидался HTTP 401 или 503, получен "
        + Строка(Ответ.КодСостояния) + ". Проверьте адрес и версию backend.";
КонецФункции

Функция СформироватьJSON(ДокументОбъект) Экспорт
    Если Не ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
        ВызватьИсключение "Сначала запишите документ.";
    КонецЕсли;
    Если ДокументОбъект.Книги.Количество() < 1 Или ДокументОбъект.Книги.Количество() > 100 Тогда
        ВызватьИсключение "В документе должно быть от 1 до 100 строк.";
    КонецЕсли;
    КнигиJSON = Новый Массив;
    Всего = 0;
    Для Каждого Позиция Из ДокументОбъект.Книги Цикл
        Если Не ЗначениеЗаполнено(Позиция.Книга) Тогда
            ВызватьИсключение "Выберите книгу в каждой строке.";
        КонецЕсли;
        Книга = Позиция.Книга;
        Название = СокрЛП(Книга.Наименование);
        Автор = СокрЛП(Книга.Автор);
        Издательство = СокрЛП(Книга.Издательство);
        Если ПустаяСтрока(Название) Или СтрДлина(Название) > 500
            Или ПустаяСтрока(Автор) Или СтрДлина(Автор) > 300
            Или ПустаяСтрока(Издательство) Или СтрДлина(Издательство) > 300 Тогда
            ВызватьИсключение "Заполните название (до 500), автора и издательство (до 300 символов).";
        КонецЕсли;
        Если Книга.ГодИздания < 1 Или Книга.ГодИздания > 9999 Тогда
            ВызватьИсключение "Год издания должен быть от 1 до 9999.";
        КонецЕсли;
        Если Позиция.Количество < 1 Или Позиция.Количество > 1000
            Или Позиция.Количество <> Цел(Позиция.Количество) Тогда
            ВызватьИсключение "Количество должно быть целым от 1 до 1000.";
        КонецЕсли;
        Всего = Всего + Позиция.Количество;
        КнигиJSON.Добавить(Новый Структура(
            "title,author,publication_year,publisher,quantity",
            Название, Автор, Книга.ГодИздания, Издательство, Позиция.Количество));
    КонецЦикла;
    Если Всего > 5000 Тогда
        ВызватьИсключение "Не более 5000 экземпляров на документ.";
    КонецЕсли;
    Данные = Новый Структура("document_id,books",
        "1c:" + Строка(ДокументОбъект.Ссылка.УникальныйИдентификатор()), КнигиJSON);
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Возврат Запись.Закрыть();
КонецФункции

Функция ОтправитьJSON(ТелоJSON) Экспорт
    Ключ = СокрЛП(Константы.КлючИнтеграции.Получить());
    Если ПустаяСтрока(Ключ) Тогда
        ВызватьИсключение "Заполните константу КлючИнтеграции значением INTEGRATION_API_KEY из backend/.env.";
    КонецЕсли;
    // MVP: файловая база и FastAPI на одном Mac. Без COM и внешних компонент.
    Соединение = Новый HTTPСоединение("127.0.0.1", 8000, , , , 30);
    Запрос = Новый HTTPЗапрос("/integration/purchases");
    Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Запрос.Заголовки.Вставить("Accept", "application/json");
    Запрос.Заголовки.Вставить("X-Integration-Key", Ключ);
    Запрос.УстановитьТелоИзСтроки(ТелоJSON, КодировкаТекста.UTF8,
        ИспользованиеByteOrderMark.НеИспользовать);
    Попытка
        Ответ = Соединение.ОтправитьДляОбработки(Запрос);
    Исключение
        ВызватьИсключение "Нет HTTP-ответа: проверьте запуск FastAPI на 127.0.0.1:8000. "
            + "Результат доставки неизвестен. Повторите отправку ЭТОГО документа: сохраненный JSON и ID не изменятся.";
    КонецПопытки;
    ТекстОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
    Если Ответ.КодСостояния <> 200 Тогда
        Подсказка = "Проверьте ответ backend.";
        Если Ответ.КодСостояния = 401 Тогда
            Подсказка = "Ключ неверен или отсутствует.";
        ИначеЕсли Ответ.КодСостояния = 409 Тогда
            Подсказка = "ID уже принят с другими данными. Не создавайте новый ID для обхода ошибки.";
        ИначеЕсли Ответ.КодСостояния = 422 Тогда
            Подсказка = "Проверьте поля и ограничения JSON; подробности в ответе.";
        ИначеЕсли Ответ.КодСостояния = 503 Тогда
            Подсказка = "Проверьте INTEGRATION_API_KEY в backend/.env и перезапустите FastAPI.";
        ИначеЕсли Ответ.КодСостояния >= 500 Тогда
            Подсказка = "Ошибка сервера. После устранения повторите отправку этого документа.";
        КонецЕсли;
        ВызватьИсключение "HTTP " + Строка(Ответ.КодСостояния) + ": " + Подсказка
            + Символы.ПС + Лев(ТекстОтвета, 3000);
    КонецЕсли;
    Попытка
        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(ТекстОтвета);
        Данные = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
        Если Данные.success <> Истина Тогда
            ВызватьИсключение "success не равен true";
        КонецЕсли;
        Результат = Данные.data;
        ЧтениеЗапроса = Новый ЧтениеJSON;
        ЧтениеЗапроса.УстановитьСтроку(ТелоJSON);
        ИсходныеДанные = ПрочитатьJSON(ЧтениеЗапроса);
        ЧтениеЗапроса.Закрыть();
        Если Результат.document_id <> ИсходныеДанные.document_id Тогда
            ВызватьИсключение "В ответе другой document_id";
        КонецЕсли;
        Если Результат.already_imported Тогда
            Сообщение = "Документ уже был принят. Повторные экземпляры не добавлены.";
        Иначе
            Сообщение = "Поступление принято.";
        КонецЕсли;
        Сообщение = Сообщение + " Новых изданий при первой загрузке: "
            + Строка(Результат.created_books) + "; экземпляров: " + Строка(Результат.created_copies) + ".";
    Исключение
        ВызватьИсключение "Получен HTTP 200, но ответ не соответствует контракту. "
            + "Доставка могла состояться: повторите отправку того же документа.";
    КонецПопытки;
    Возврат Сообщение;
КонецФункции
