// Модуль управляемой формы документа ПоступлениеКниг.
&НаКлиенте
Процедура ПроверитьHTTP(Команда)
    Попытка
        Сообщить(ПроверитьHTTPНаСервере());
    Исключение
        Сообщить(ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьHTTPНаСервере()
    Возврат ОбменБиблиотека.ПроверитьHTTP();
КонецФункции

&НаКлиенте
Процедура ОтправитьВБиблиотеку(Команда)
    Попытка
        // Стандартный метод формы сохраняет в том числе несохраненные строки.
        Если Не Записать() Тогда
            Возврат;
        КонецЕсли;
        Сообщить(ОтправитьНаСервере());
    Исключение
        Сообщить(ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ОтправитьНаСервере()
    ДокументОбъект = Объект.Ссылка.ПолучитьОбъект();
    Если ДокументОбъект.ПометкаУдаления Тогда
        ВызватьИсключение "Нельзя отправить документ с пометкой удаления.";
    КонецЕсли;
    ТекущийJSON = ОбменБиблиотека.СформироватьJSON(ДокументОбъект);
    Если ПустаяСтрока(ДокументОбъект.JSONОтправки) Тогда
        // Снимок сохраняется ДО сети: после таймаута не создаем другой документ.
        ДокументОбъект.JSONОтправки = ТекущийJSON;
        ДокументОбъект.Записать();
        ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
    ИначеЕсли ДокументОбъект.JSONОтправки <> ТекущийJSON Тогда
        ВызватьИсключение "После первой попытки изменились строки или карточка книги. "
            + "Верните исходные данные. Изменение уже отправленного поступления в MVP не поддерживается.";
    КонецЕсли;
    // Не держим транзакцию 1С во время сетевого вызова.
    Результат = ОбменБиблиотека.ОтправитьJSON(ДокументОбъект.JSONОтправки);
    ДокументОбъект.Отправлен = Истина;
    Попытка
        ДокументОбъект.Записать();
        ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
    Исключение
        Возврат Результат + " Не удалось сохранить отметку в 1С. Повторная отправка безопасна.";
    КонецПопытки;
    Возврат Результат;
КонецФункции
